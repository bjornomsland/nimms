<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <!-- Tailwind CDN for quick local run (not for production) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* Small fallback styles */
      body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <div class="min-h-screen flex flex-col items-center justify-center p-6">
      <img src="/images/nimms-logo.png" alt="NIMMS" class="w-40 h-auto mb-6" onerror="this.style.display='none'" />
      <h1 class="text-3xl font-extrabold mb-2"><%= title %></h1>
      <p class="max-w-xl text-center text-gray-700 mb-6"><%= description %></p>

      <div class="space-x-3">
        <a href="/" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Hjem</a>
        <a href="/api/contact" class="px-4 py-2 bg-gray-200 text-gray-800 rounded">Kontakt (API)</a>
      </div>

      <footer class="mt-12 text-sm text-gray-500">
        <p>Server: Express · Views: EJS</p>
      </footer>
    </div>
  </body>
</html>
